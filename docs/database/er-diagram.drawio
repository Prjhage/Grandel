<mxfile host="app.diagrams.net" modified="2026-09-17T19:30:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="database-er-grandel" name="Grandel Database ER Diagram">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#0f172a" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="Grandel - MongoDB Database Entity-Relationship Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="284" y="20" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- USER TABLE -->
        <mxCell id="tbl-user" value="User Collection&#xa;--------------------------------------------&#xa;• _id: ObjectId [PK]&#xa;• email: String [Unique]&#xa;• username: String&#xa;• firebaseUid: String [Index]&#xa;• phoneHash: String&#xa;• phoneLast4: String&#xa;• role: Enum('user', 'host', 'partner')&#xa;• wishlist: [ObjectId -&gt; Listing]&#xa;• avatar: { url: String, filename: String }&#xa;• isActive: Boolean&#xa;• resetPasswordToken: String&#xa;• resetPasswordExpires: Date&#xa;• createdAt: Date&#xa;• updatedAt: Date" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="280" height="340" as="geometry" />
        </mxCell>

        <!-- LISTING TABLE -->
        <mxCell id="tbl-listing" value="Listing Collection&#xa;--------------------------------------------&#xa;• _id: ObjectId [PK]&#xa;• title: String&#xa;• description: String&#xa;• category: Enum (14 Categories)&#xa;• image: { url, filename }&#xa;• images: [{ url, filename }]&#xa;• amenities: [String]&#xa;• price: Number&#xa;• location: String, country: String&#xa;• geometry: { type: 'Point', coordinates }&#xa;• numRooms: Number (def: 1)&#xa;• guestsPerRoom: Number (def: 2)&#xa;• petsAllowed: Boolean, petChargePerNight&#xa;• discount: Number&#xa;• avgRating: Number, ratingCount: Number&#xa;• Owner: ObjectId -&gt; User [FK]&#xa;• reviews: [ObjectId -&gt; Review]&#xa;• travelCompanion: { places, food }" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#1E293B;strokeColor=#10B981;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="440" y="100" width="310" height="420" as="geometry" />
        </mxCell>

        <!-- BOOKING TABLE -->
        <mxCell id="tbl-booking" value="Booking Collection&#xa;--------------------------------------------&#xa;• _id: ObjectId [PK]&#xa;• listing: ObjectId -&gt; Listing [FK]&#xa;• user: ObjectId -&gt; User [FK]&#xa;• startDate: Date, endDate: Date&#xa;• nights: Number, numRooms: Number&#xa;• guests: { adults, children, animals }&#xa;• pricePerNight: Number&#xa;• subtotal: Number, gst: Number&#xa;• totalPrice: Number&#xa;• discountApplied: Boolean, discountAmount&#xa;• travelCompanion: { weather, budget, plan }&#xa;• status: 'pending'|'confirmed'|'completed'&#xa;• payment: { razorpayOrderId, status }&#xa;• createdAt: Date, updatedAt: Date" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#1E293B;strokeColor=#F59E0B;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="840" y="100" width="290" height="380" as="geometry" />
        </mxCell>

        <!-- REVIEW TABLE -->
        <mxCell id="tbl-review" value="Review Collection&#xa;--------------------------------------------&#xa;• _id: ObjectId [PK]&#xa;• comment: String&#xa;• rating: Number (1 - 5)&#xa;• author: ObjectId -&gt; User [FK]&#xa;• createdAt: Date" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#1E293B;strokeColor=#EC4899;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="440" y="580" width="310" height="150" as="geometry" />
        </mxCell>

        <!-- RELATIONSHIPS -->
        <!-- User -> Listing (Owner) -->
        <mxCell id="rel-user-listing" value="1 : N (Owner)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38BDF8;strokeWidth=2;fontColor=#38BDF8;fontSize=11;" edge="1" parent="1" source="tbl-user" target="tbl-listing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Listing -> Booking -->
        <mxCell id="rel-listing-booking" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;fontColor=#10B981;fontSize=11;" edge="1" parent="1" source="tbl-listing" target="tbl-booking">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- User -> Booking (Guest) -->
        <mxCell id="rel-user-booking" value="1 : N (Guest)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6366F1;strokeWidth=2;fontColor=#818CF8;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="tbl-user" target="tbl-booking">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="520" />
              <mxPoint x="985" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Listing -> Review -->
        <mxCell id="rel-listing-review" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EC4899;strokeWidth=2;fontColor=#EC4899;fontSize=11;" edge="1" parent="1" source="tbl-listing" target="tbl-review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- User -> Review (Author) -->
        <mxCell id="rel-user-review" value="1 : N (Author)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#A78BFA;fontSize=11;exitX=0.25;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="tbl-user" target="tbl-review">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="130" y="655" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
